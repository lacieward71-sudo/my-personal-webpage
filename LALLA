<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5eaff">
  <title>my little corner of the internet</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="toolbar">
    <div class="brand"><span class="brand-mark">✿</span><span>my little corner</span></div>
    <div class="toolbar-actions">
      <button id="editToggle" class="button primary" type="button">✎ Edit page</button>
      <button id="saveBtn" class="button" type="button">Save layout</button>
      <button id="resetBtn" class="button subtle" type="button" title="Restore the starter layout">Reset</button>
    </div>
  </header>

  <main>
    <section class="editor-panel" id="editorPanel" aria-label="Website editor" hidden>
      <div class="panel-heading">
        <div><p class="eyebrow">YOUR PAGE, YOUR RULES</p><h1>Page editor</h1></div>
        <button id="closeEditor" class="icon-button" type="button" aria-label="Close editor">×</button>
      </div>
      <p class="helper">Choose an item on the page to move it. Drag its bottom-right corner to resize it. Changes save in this browser; use “Export layout” to keep a backup.</p>
      <div class="editor-grid">
        <section class="editor-card">
          <h2>Add to your page</h2>
          <div class="button-stack">
            <button class="button full" id="addText" type="button">＋ Text box</button>
            <button class="button full" id="addImage" type="button">＋ Image / GIF</button>
            <button class="button full" id="addSticker" type="button">＋ Sticker</button>
          </div>
          <p class="small-note">For images, paste a direct image URL ending in .gif, .png, .jpg, or .webp, or use an image hosted in your GitHub repository.</p>
        </section>
        <section class="editor-card">
          <h2>Page style</h2>
          <label class="field">Background color <input id="bgColor" type="color" value="#f7efff"></label>
          <label class="field">Card color <input id="cardColor" type="color" value="#ffffff"></label>
          <label class="field">Accent color <input id="accentColor" type="color" value="#b58add"></label>
          <label class="field">Text color <input id="textColor" type="color" value="#3b2d49"></label>
          <label class="field">Background image URL <input id="bgImage" type="url" placeholder="https://… (optional)"></label>
          <label class="field">Page title <input id="pageTitle" type="text" value="my little corner of the internet"></label>
          <button class="button full" id="applyStyle" type="button">Apply style</button>
        </section>
        <section class="editor-card">
          <h2>Music player</h2>
          <p class="small-note">Add a direct audio file URL (MP3, OGG, or WAV). Browsers generally require visitors to press play themselves.</p>
          <label class="field">Song title <input id="songTitle" type="text" placeholder="a song for this page"></label>
          <label class="field">Audio file URL <input id="audioUrl" type="url" placeholder="https://…/song.mp3"></label>
          <button class="button full" id="applyMusic" type="button">Update music player</button>
        </section>
        <section class="editor-card">
          <h2>Selected item</h2>
          <p id="selectionHelp" class="small-note">Click an item on the page while editing to change it here.</p>
          <label class="field">Text / caption <textarea id="itemText" rows="3" placeholder="Text for the selected box"></textarea></label>
          <label class="field">Image URL <input id="itemImage" type="url" placeholder="https://…/image.gif"></label>
          <label class="field">Link URL <input id="itemLink" type="url" placeholder="https://… (optional)"></label>
          <div class="two-buttons">
            <button class="button" id="applyItem" type="button">Apply</button>
            <button class="button danger" id="deleteItem" type="button">Delete</button>
          </div>
        </section>
        <section class="editor-card">
          <h2>Backups</h2>
          <button class="button full" id="exportBtn" type="button">Export layout (.json)</button>
          <label class="button full file-button">Import layout (.json)<input id="importFile" type="file" accept="application/json,.json"></label>
          <p class="small-note">Your layout is saved on this device/browser. Export a backup before switching devices or clearing browser data.</p>
        </section>
      </div>
    </section>

    <div class="notice" id="editNotice" hidden>EDIT MODE · Drag items to move them · Drag the corner to resize · Click an item to edit it</div>

    <section class="page-shell" id="pageShell">
      <div class="page-topline"><span>✧ welcome to my page ✧</span><span id="visitorDate"></span></div>
      <div class="canvas" id="canvas" aria-label="Your personal webpage">
        <article class="site-item profile-card" data-item-id="welcome" style="left:4%;top:4%;width:42%;min-height:230px">
          <div class="item-content">
            <p class="eyebrow">✦ ABOUT ME ✦</p>
            <h1 contenteditable="false">hi, i'm <span class="accent-text">your name</span>!</h1>
            <p>Welcome to my little corner of the internet. This is where I collect things I love, share a little about myself, and make a page that feels like <em>me</em>.</p>
            <div class="pill-row"><span class="pill">♡ your pronouns</span><span class="pill">✧ your interests</span></div>
          </div>
        </article>

        <article class="site-item image-card" data-item-id="hero-image" style="left:53%;top:5%;width:27%;height:220px">
          <div class="item-content image-content">
            <img src="https://placehold.co/320x240/f0e4ff/765a91?text=your+GIF+here" alt="Example placeholder; replace with your own GIF" draggable="false">
            <p class="caption">✿ replace me with a favorite gif ✿</p>
          </div>
        </article>

        <article class="site-item note-card" data-item-id="currently" style="left:5%;top:39%;width:27%;min-height:155px">
          <div class="item-content">
            <h2>♡ currently</h2>
            <p>♪ listening to: something good</p>
            <p>☁ thinking about: everything</p>
            <p>☆ obsessed with: my interests</p>
          </div>
        </article>

        <article class="site-item note-card" data-item-id="interests" style="left:36%;top:39%;width:39%;min-height:155px">
          <div class="item-content">
            <h2>✧ things i love</h2>
            <p>Put your favorite games, music, shows, characters, hobbies, friends, or anything else here. You can edit or move this box!</p>
            <div class="sticker-row"><span>♡</span><span>☆</span><span>✿</span><span>☾</span><span>୨୧</span></div>
          </div>
        </article>

        <article class="site-item music-card" data-item-id="music" style="left:5%;top:67%;width:35%;min-height:120px">
          <div class="item-content">
            <h2>♫ my little music player</h2>
            <p class="music-title" id="musicTitle">add a song in edit mode</p>
            <audio id="audioPlayer" controls preload="none"></audio>
            <p class="tiny">press play to listen ♡</p>
          </div>
        </article>

        <article class="site-item links-card" data-item-id="links" style="left:45%;top:68%;width:30%;min-height:110px">
          <div class="item-content">
            <h2>links & socials</h2>
            <p><a href="#" data-placeholder-link>my socials</a> · <a href="#" data-placeholder-link>guestbook</a> · <a href="#" data-placeholder-link>more about me</a></p>
            <p class="tiny">Edit this text and add your own links.</p>
          </div>
        </article>

        <div class="site-item floating-sticker" data-item-id="sticker-star" style="left:83%;top:37%;width:10%;height:70px">
          <div class="item-content sticker-content"><span aria-label="sparkles">✧</span></div>
        </div>
        <div class="site-item floating-sticker" data-item-id="sticker-heart" style="left:82%;top:65%;width:11%;height:70px">
          <div class="item-content sticker-content"><span aria-label="heart">♡</span></div>
        </div>
      </div>
      <footer class="page-footer">made with ♡ by me · <span id="footerTitle">my little corner of the internet</span></footer>
    </section>
    <p class="bottom-hint">Tip: tap <strong>Edit page</strong> to customize everything. On phones, drag items by their little top bar while edit mode is on.</p>
  </main>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script src="script.js"></script>
</body>
</html>
(() => {
  "use strict";
  const $ = (selector, root = document) => root.querySelector(selector);
  const canvas = $("#canvas");
  const pageShell = $("#pageShell");
  const editorPanel = $("#editorPanel");
  const editNotice = $("#editNotice");
  const toast = $("#toast");
  const STORAGE_KEY = "little-corner-profile-v1";
  let editing = false;
  let selected = null;
  let toastTimer;

  const starter = {
    styles: { bgColor: "#f7efff", cardColor: "#ffffff", accentColor: "#b58add", textColor: "#3b2d49", bgImage: "", pageTitle: "my little corner of the internet" },
    music: { title: "", url: "" },
    items: null
  };

  function showToast(message) {
    toast.textContent = message;
    toast.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove("show"), 2300);
  }

  function addHandles(item) {
    if (!item.querySelector(".drag-handle")) {
      const drag = document.createElement("span");
      drag.className = "drag-handle";
      drag.textContent = "↕ move";
      drag.setAttribute("aria-hidden", "true");
      item.appendChild(drag);
    }
    if (!item.querySelector(".resize-handle")) {
      const resize = document.createElement("span");
      resize.className = "resize-handle";
      resize.setAttribute("aria-label", "Resize item");
      item.appendChild(resize);
    }
  }

  function cleanItem(item) {
    const clone = item.cloneNode(true);
    clone.querySelectorAll(".drag-handle, .resize-handle").forEach(el => el.remove());
    clone.classList.remove("selected");
    return clone;
  }

  function setEditing(value) {
    editing = value;
    document.body.classList.toggle("edit-mode", editing);
    editorPanel.hidden = !editing;
    editNotice.hidden = !editing;
    $("#editToggle").textContent = editing ? "✓ Done editing" : "✎ Edit page";
    canvas.querySelectorAll(".site-item").forEach(item => {
      if (editing) addHandles(item);
      else item.querySelectorAll(".drag-handle, .resize-handle").forEach(el => el.remove());
    });
    if (!editing) {
      if (selected) selected.classList.remove("selected");
      selected = null;
    }
  }

  function selectItem(item) {
    if (!editing) return;
    if (selected) selected.classList.remove("selected");
    selected = item;
    item.classList.add("selected");
    const content = item.querySelector(".item-content");
    const img = content && content.querySelector("img");
    $("#itemText").value = content ? content.innerText.trim() : "";
    $("#itemImage").value = img ? (img.getAttribute("src") || "") : "";
    const link = content && content.querySelector("a[href]:not([data-placeholder-link])");
    $("#itemLink").value = link ? link.href : "";
    $("#selectionHelp").textContent = "Selected: " + (item.dataset.itemId || "new item");
  }

  function addItem(type) {
    const item = document.createElement("article");
    item.className = "site-item note-card";
    item.dataset.itemId = "item-" + Math.random().toString(36).slice(2, 8);
    const count = canvas.querySelectorAll(".site-item").length;
    item.style.left = (8 + (count % 4) * 4) + "%";
    item.style.top = Math.min(82, 8 + (count % 5) * 5) + "%";
    item.style.width = "30%";
    item.style.minHeight = type === "image" ? "170px" : "120px";
    if (type === "image") {
      item.classList.add("image-card");
      item.innerHTML = '<div class="item-content image-content"><img src="https://placehold.co/320x200/f0e4ff/765a91?text=Your+image" alt="Your image"><p class="caption">your caption here</p></div>';
    } else if (type === "sticker") {
      item.className = "site-item floating-sticker";
      item.style.width = "12%";
      item.style.height = "80px";
      item.innerHTML = '<div class="item-content sticker-content"><span>♡</span></div>';
    } else {
      item.innerHTML = '<div class="item-content"><h2>new text box</h2><p>Double-click the text in the selected-item editor to change it there.</p></div>';
    }
    canvas.appendChild(item);
    if (editing) addHandles(item);
    selectItem(item);
    showToast("Added! Drag it to where you want.");
    return item;
  }

  function applyItemChanges() {
    if (!selected) { showToast("Select an item on the page first."); return; }
    const content = selected.querySelector(".item-content");
    if (!content) return;
    const text = $("#itemText").value.trim();
    const imageUrl = $("#itemImage").value.trim();
    const linkUrl = $("#itemLink").value.trim();

    if (selected.classList.contains("floating-sticker")) {
      const span = content.querySelector("span");
      if (span && text) span.textContent = text.slice(0, 120);
    } else if (selected.classList.contains("image-card")) {
      let img = content.querySelector("img");
      if (imageUrl) {
        if (!img) {
          img = document.createElement("img");
          img.alt = "Custom image";
          content.prepend(img);
        }
        img.src = imageUrl;
      }
      let caption = content.querySelector(".caption");
      if (!caption) {
        caption = document.createElement("p");
        caption.className = "caption";
        content.appendChild(caption);
      }
      caption.textContent = text || "✿";
    } else {
      // Keep the content safe: the editor treats input as text, not executable HTML.
      let textNode = content.querySelector(".editable-copy");
      if (!textNode) {
        textNode = document.createElement("div");
        textNode.className = "editable-copy";
        content.appendChild(textNode);
      }
      textNode.textContent = text;
      textNode.style.whiteSpace = "pre-wrap";
    }

    if (linkUrl) {
      let link = content.querySelector("a.user-link");
      if (!link) {
        link = document.createElement("a");
        link.className = "user-link";
        link.textContent = "open link ↗";
        content.appendChild(link);
      }
      link.href = linkUrl;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
    } else {
      content.querySelectorAll("a.user-link").forEach(a => a.remove());
    }
    showToast("Item updated.");
  }

  function applyStyles() {
    const styles = {
      bgColor: $("#bgColor").value,
      cardColor: $("#cardColor").value,
      accentColor: $("#accentColor").value,
      textColor: $("#textColor").value,
      bgImage: $("#bgImage").value.trim(),
      pageTitle: $("#pageTitle").value.trim() || "my little corner of the internet"
    };
    document.documentElement.style.setProperty("--page-bg", styles.bgColor);
    document.documentElement.style.setProperty("--card-bg", styles.cardColor);
    document.documentElement.style.setProperty("--accent", styles.accentColor);
    document.documentElement.style.setProperty("--text", styles.textColor);
    canvas.style.backgroundImage = styles.bgImage
      ? `linear-gradient(rgba(255,255,255,.12), rgba(255,255,255,.12)), url("${styles.bgImage.replace(/"/g, "%22")}"), radial-gradient(rgba(181,138,221,.13) 1px, transparent 1px)`
      : "radial-gradient(rgba(181,138,221,.17) 1px, transparent 1px)";
    canvas.style.backgroundSize = styles.bgImage ? "cover, cover, 18px 18px" : "18px 18px";
    canvas.style.backgroundPosition = "center";
    document.title = styles.pageTitle;
    $("#footerTitle").textContent = styles.pageTitle;
    $("#visitorDate").textContent = new Date().toLocaleDateString(undefined, { month: "short", day: "numeric" });
    return styles;
  }

  function applyMusic() {
    const title = $("#songTitle").value.trim() || "a song for this page";
    const url = $("#audioUrl").value.trim();
    $("#musicTitle").textContent = title;
    const player = $("#audioPlayer");
    if (url) {
      player.src = url;
      player.hidden = false;
      player.load();
      showToast("Music player updated. Visitors can press play.");
    } else {
      player.removeAttribute("src");
      player.load();
      showToast("Add a direct MP3, OGG, or WAV link to play music.");
    }
  }

  function serialize() {
    const items = [...canvas.querySelectorAll(".site-item")].map(item => {
      const clone = cleanItem(item);
      return {
        id: item.dataset.itemId || "",
        className: [...item.classList].filter(c => c !== "selected").join(" "),
        style: item.getAttribute("style") || "",
        html: clone.innerHTML
      };
    });
    return {
      styles: {
        bgColor: $("#bgColor").value,
        cardColor: $("#cardColor").value,
        accentColor: $("#accentColor").value,
        textColor: $("#textColor").value,
        bgImage: $("#bgImage").value,
        pageTitle: $("#pageTitle").value
      },
      music: { title: $("#songTitle").value, url: $("#audioUrl").value },
      items
    };
  }

  function saveLayout(showMessage = true) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(serialize()));
      if (showMessage) showToast("Layout saved in this browser!");
    } catch (error) {
      showToast("Couldn't save here. Try exporting your layout instead.");
    }
  }

  function restoreItems(items) {
    if (!Array.isArray(items) || !items.length) return;
    canvas.querySelectorAll(".site-item").forEach(item => item.remove());
    items.forEach(data => {
      if (typeof data.html !== "string") return;
      const item = document.createElement("article");
      item.className = String(data.className || "site-item note-card");
      item.dataset.itemId = String(data.id || "");
      item.setAttribute("style", String(data.style || ""));
      // Layout JSON is user-created. Keep imported markup constrained to basic profile widgets.
      const template = document.createElement("template");
      template.innerHTML = data.html;
      template.content.querySelectorAll("script, iframe, object, embed, link, style").forEach(el => el.remove());
      item.appendChild(template.content);
      canvas.appendChild(item);
    });
    setEditing(editing);
  }

  function loadLayout(data) {
    if (!data || typeof data !== "object") throw new Error("That file doesn't look like a layout.");
    const styles = data.styles || {};
    $("#bgColor").value = styles.bgColor || starter.styles.bgColor;
    $("#cardColor").value = styles.cardColor || starter.styles.cardColor;
    $("#accentColor").value = styles.accentColor || starter.styles.accentColor;
    $("#textColor").value = styles.textColor || starter.styles.textColor;
    $("#bgImage").value = styles.bgImage || "";
    $("#pageTitle").value = styles.pageTitle || starter.styles.pageTitle;
    applyStyles();
    const music = data.music || {};
    $("#songTitle").value = music.title || "";
    $("#audioUrl").value = music.url || "";
    applyMusic();
    restoreItems(data.items);
    saveLayout(false);
  }

  function resetLayout() {
    if (!confirm("Reset your page to the original starter layout? This replaces the saved layout in this browser.")) return;
    localStorage.removeItem(STORAGE_KEY);
    location.reload();
  }

  // Dragging and resizing use pointer events, so mouse and touch are both supported.
  let pointerAction = null;
  canvas.addEventListener("pointerdown", event => {
    if (!editing) return;
    const item = event.target.closest(".site-item");
    if (!item) return;
    selectItem(item);
    const resizeHandle = event.target.closest(".resize-handle");
    const dragHandle = event.target.closest(".drag-handle");
    if (!resizeHandle && !dragHandle) return;
    event.preventDefault();
    const canvasRect = canvas.getBoundingClientRect();
    const rect = item.getBoundingClientRect();
    pointerAction = {
      type: resizeHandle ? "resize" : "move",
      item,
      startX: event.clientX,
      startY: event.clientY,
      left: rect.left - canvasRect.left,
      top: rect.top - canvasRect.top,
      width: rect.width,
      height: rect.height,
      canvasWidth: canvasRect.width,
      canvasHeight: canvasRect.height
    };
    try { item.setPointerCapture(event.pointerId); } catch (_) {}
  });

  canvas.addEventListener("pointermove", event => {
    if (!pointerAction) return;
    const a = pointerAction;
    const dx = event.clientX - a.startX;
    const dy = event.clientY - a.startY;
    if (a.type === "move") {
      const left = Math.max(0, Math.min(a.canvasWidth - 40, a.left + dx));
      const top = Math.max(0, Math.min(a.canvasHeight - 35, a.top + dy));
      a.item.style.left = (left / a.canvasWidth * 100) + "%";
      a.item.style.top = (top / a.canvasHeight * 100) + "%";
    } else {
      const width = Math.max(70, Math.min(a.canvasWidth - a.left, a.width + dx));
      const height = Math.max(55, Math.min(a.canvasHeight - a.top, a.height + dy));
      a.item.style.width = (width / a.canvasWidth * 100) + "%";
      a.item.style.height = height + "px";
      a.item.style.minHeight = "0";
    }
  });
  const endPointer = () => { if (pointerAction) saveLayout(false); pointerAction = null; };
  canvas.addEventListener("pointerup", endPointer);
  canvas.addEventListener("pointercancel", endPointer);

  canvas.addEventListener("click", event => {
    if (!editing) return;
    const item = event.target.closest(".site-item");
    if (item) selectItem(item);
  });
  canvas.addEventListener("click", event => {
    const link = event.target.closest("[data-placeholder-link]");
    if (link) event.preventDefault();
  });

  $("#editToggle").addEventListener("click", () => setEditing(!editing));
  $("#closeEditor").addEventListener("click", () => setEditing(false));
  $("#saveBtn").addEventListener("click", () => saveLayout(true));
  $("#resetBtn").addEventListener("click", resetLayout);
  $("#addText").addEventListener("click", () => addItem("text"));
  $("#addImage").addEventListener("click", () => {
    const item = addItem("image");
    selectItem(item);
    $("#selectionHelp").textContent = "Paste an image/GIF URL in the Image URL field, then press Apply.";
  });
  $("#addSticker").addEventListener("click", () => addItem("sticker"));
  $("#applyStyle").addEventListener("click", () => { applyStyles(); saveLayout(false); showToast("Page style updated!"); });
  $("#applyMusic").addEventListener("click", () => { applyMusic(); saveLayout(false); });
  $("#applyItem").addEventListener("click", () => { applyItemChanges(); saveLayout(false); });
  $("#deleteItem").addEventListener("click", () => {
    if (!selected) { showToast("Select an item first."); return; }
    selected.remove();
    selected = null;
    $("#selectionHelp").textContent = "Item deleted.";
    $("#itemText").value = "";
    $("#itemImage").value = "";
    $("#itemLink").value = "";
    saveLayout(false);
    showToast("Item deleted.");
  });
  $("#exportBtn").addEventListener("click", () => {
    const blob = new Blob([JSON.stringify(serialize(), null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "my-profile-layout.json";
    a.click();
    URL.revokeObjectURL(url);
    showToast("Layout backup exported.");
  });
  $("#importFile").addEventListener("change", async event => {
    const file = event.target.files && event.target.files[0];
    if (!file) return;
    try {
      const data = JSON.parse(await file.text());
      loadLayout(data);
      showToast("Layout imported!");
    } catch (error) {
      showToast("Couldn't import that file. Try a layout JSON backup.");
    }
    event.target.value = "";
  });

  // Restore saved layout if available; otherwise use the starter layout.
  try {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) loadLayout(JSON.parse(saved));
    else {
      applyStyles();
      $("#audioPlayer").hidden = false;
    }
  } catch (error) {
    applyStyles();
  }
  setEditing(false);
})();
@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Pacifico&display=swap');
:root {
  --page-bg: #f7efff;
  --card-bg: #ffffff;
  --accent: #b58add;
  --text: #3b2d49;
  --muted: #806f8d;
  --border: #e4d5f0;
  --shadow: 0 8px 24px rgba(72, 45, 93, .09);
}
* { box-sizing: border-box; }
html { min-height: 100%; }
body { margin: 0; background: var(--page-bg); color: var(--text); font-family: Nunito, system-ui, sans-serif; transition: background .2s ease; }
button, input, textarea { font: inherit; }
button { cursor: pointer; }
.toolbar { position: sticky; top: 0; z-index: 1000; display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 12px clamp(14px, 3vw, 32px); background: rgba(255,255,255,.88); border-bottom: 1px solid var(--border); backdrop-filter: blur(14px); }
.brand { display: flex; align-items: center; gap: 10px; font-weight: 800; letter-spacing: -.02em; }
.brand-mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 12px; background: var(--accent); color: white; font-size: 21px; }
.toolbar-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
.button { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 38px; padding: 8px 13px; color: var(--text); background: white; border: 1px solid var(--border); border-radius: 12px; font-weight: 800; font-size: 13px; text-decoration: none; transition: transform .15s, box-shadow .15s; }
.button:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(72,45,93,.10); }
.button.primary { background: var(--accent); color: white; border-color: transparent; }
.button.subtle { background: transparent; }
.button.danger { color: #a22e58; border-color: #edc6d3; background: #fff6f8; }
.button.full { width: 100%; }
.button-stack { display: grid; gap: 8px; }
main { max-width: 1200px; margin: 0 auto; padding: 22px clamp(12px, 3vw, 30px) 50px; }
.page-shell { overflow: hidden; border: 1px solid var(--border); border-radius: 22px; background: rgba(255,255,255,.42); box-shadow: var(--shadow); }
.page-topline { display: flex; justify-content: space-between; gap: 12px; padding: 12px 18px; background: var(--card-bg); color: var(--muted); border-bottom: 1px dashed var(--border); font-size: 12px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
.canvas { position: relative; min-height: 760px; overflow: hidden; background-color: var(--page-bg); background-image: radial-gradient(rgba(181,138,221,.17) 1px, transparent 1px); background-size: 18px 18px; }
.site-item { position: absolute; z-index: 1; overflow: visible; border: 1px solid var(--border); border-radius: 18px; background: var(--card-bg); box-shadow: 0 6px 18px rgba(72,45,93,.08); }
.site-item .item-content { width: 100%; height: 100%; min-height: inherit; padding: 18px; overflow: hidden; border-radius: inherit; overflow-wrap: anywhere; }
.site-item h1 { margin: 4px 0 12px; font-size: clamp(23px, 3vw, 36px); line-height: 1.14; letter-spacing: -.04em; }
.site-item h2 { margin: 0 0 10px; font-size: clamp(16px, 1.8vw, 21px); }
.site-item p { margin: 7px 0; line-height: 1.55; font-size: 14px; }
.site-item a { color: var(--accent); font-weight: 800; }
.eyebrow { color: var(--accent); font-size: 10px !important; font-weight: 900; letter-spacing: .17em; }
.accent-text { color: var(--accent); }
.pill-row, .sticker-row { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin-top: 13px; }
.pill { padding: 5px 9px; border-radius: 999px; background: color-mix(in srgb, var(--accent) 16%, white); color: var(--text); font-size: 11px; font-weight: 800; }
.sticker-row span { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 10px; background: color-mix(in srgb, var(--accent) 17%, white); color: var(--accent); font-size: 18px; }
.image-card { padding: 0; }
.image-card .item-content { padding: 10px; display: flex; flex-direction: column; gap: 6px; }
.image-content img { display: block; width: 100%; height: calc(100% - 24px); min-height: 100px; object-fit: cover; border-radius: 11px; }
.caption { margin: 0 !important; color: var(--muted); font-size: 10px !important; text-align: center; }
.music-card audio { width: 100%; height: 38px; }
.music-title { color: var(--muted); font-size: 12px !important; }
.tiny { color: var(--muted); font-size: 10px !important; }
.floating-sticker { border: 0; box-shadow: none; background: transparent; }
.floating-sticker .item-content { display: grid; place-items: center; padding: 0; }
.sticker-content span { display: block; color: var(--accent); font-size: clamp(40px, 6vw, 74px); text-shadow: 2px 3px 0 rgba(181,138,221,.15); transform: rotate(-12deg); }
.page-footer { padding: 14px 18px; text-align: center; color: var(--muted); background: var(--card-bg); border-top: 1px dashed var(--border); font-size: 11px; }
.bottom-hint { color: var(--muted); text-align: center; font-size: 12px; margin: 16px 0 0; }
.notice { margin: 0 0 12px; padding: 10px 14px; border: 1px solid var(--accent); border-radius: 12px; color: var(--text); background: color-mix(in srgb, var(--accent) 14%, white); font-size: 12px; font-weight: 800; text-align: center; }
.editor-panel { margin-bottom: 18px; padding: clamp(14px, 3vw, 24px); border: 1px solid var(--border); border-radius: 20px; background: white; box-shadow: var(--shadow); }
.panel-heading { display: flex; justify-content: space-between; align-items: start; gap: 12px; }
.panel-heading h1 { margin: 0; font-size: 26px; }
.panel-heading .eyebrow { margin: 0 0 4px; }
.icon-button { width: 34px; height: 34px; border: 1px solid var(--border); border-radius: 10px; background: white; font-size: 22px; color: var(--text); }
.helper, .small-note { color: var(--muted); font-size: 12px; line-height: 1.5; }
.editor-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 16px; }
.editor-card { min-width: 0; padding: 15px; border: 1px solid var(--border); border-radius: 15px; background: #fdfbff; }
.editor-card h2 { margin: 0 0 12px; font-size: 15px; }
.field { display: grid; gap: 6px; margin: 10px 0; color: var(--muted); font-size: 12px; font-weight: 800; }
.field input:not([type=color]), .field textarea { width: 100%; min-width: 0; padding: 10px 11px; border: 1px solid var(--border); border-radius: 10px; background: white; color: var(--text); outline: none; font-size: 13px; }
.field input:focus, .field textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent); }
.field input[type=color] { width: 100%; height: 35px; padding: 3px; border: 1px solid var(--border); border-radius: 10px; background: white; }
.two-buttons { display: flex; gap: 8px; }
.two-buttons .button { flex: 1; }
.file-button { position: relative; margin-top: 8px; }
.file-button input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
.toast { position: fixed; z-index: 1200; left: 50%; bottom: 20px; transform: translate(-50%, 20px); opacity: 0; pointer-events: none; padding: 11px 16px; border-radius: 12px; background: #30243a; color: white; font-size: 13px; font-weight: 800; box-shadow: var(--shadow); transition: .2s; max-width: calc(100vw - 24px); text-align: center; }
.toast.show { opacity: 1; transform: translate(-50%, 0); }
.edit-mode .site-item { cursor: grab; outline: 2px dashed transparent; touch-action: none; }
.edit-mode .site-item:hover, .edit-mode .site-item.selected { outline-color: var(--accent); z-index: 20; }
.edit-mode .site-item:active { cursor: grabbing; }
.drag-handle { display: none; }
.edit-mode .drag-handle { position: absolute; z-index: 30; top: -12px; left: 8px; display: block; padding: 3px 7px; border-radius: 7px; background: var(--accent); color: white; font-size: 10px; font-weight: 900; line-height: 1.5; cursor: grab; }
.resize-handle { display: none; }
.edit-mode .resize-handle { position: absolute; z-index: 35; right: -5px; bottom: -5px; display: block; width: 17px; height: 17px; border: 2px solid white; border-radius: 5px; background: var(--accent); cursor: nwse-resize; touch-action: none; }
[hidden] { display: none !important; }
@media (max-width: 700px) {
  .toolbar { align-items: flex-start; }
  .brand { font-size: 13px; padding-top: 4px; }
  .toolbar-actions { gap: 5px; }
  .toolbar-actions .button { min-height: 34px; padding: 6px 9px; font-size: 11px; }
  main { padding: 14px 9px 35px; }
  .editor-grid { grid-template-columns: 1fr; }
  .canvas { min-height: 1080px; }
  .site-item .item-content { padding: 12px; }
  .site-item p { font-size: 12px; }
  .site-item h1 { font-size: 23px; }
  .profile-card { min-height: 230px; }
  .page-topline { font-size: 9px; padding: 10px 12px; }}
